# 吱一声（Chirp）配置模板
# 复制为 .env 后修改；已有 .env 时请合并配置。
# 使用简单 KEY=VALUE 格式，注释独占一行。

# 数据源：dws 为实时钉钉，cache 为本地快照。
RADAR_SOURCE=dws

# 决策引擎：jev / laya / mock。
# Jev 必须填写 TYPESAFE_API_KEY。
# Laya 需额外安装 requirements-local.txt，不需要 Jev Key。
RADAR_ENGINE=jev
TYPESAFE_API_KEY=

# 建议填写自己发送过的消息中的 senderId，用于优先选择他人消息。
RADAR_SELF_ID=

# 自动刷新间隔与每次 DWS 命令的等待上限，单位秒。
RADAR_POLL_INTERVAL=30
DWS_TIMEOUT=20

# 如果应用找不到 DWS，取消下一行注释并替换为 command -v dws 的输出。
# 未指定时从 PATH 查找；不要写 DWS_BIN= 空值。
# DWS_BIN=/absolute/path/to/dws

# 可选 LLM：三项同时填写才启用详细解读与回复生成。
# Base URL 为基础地址，程序自动追加 /chat/completions。
RADAR_LLM_BASE_URL=
RADAR_LLM_API_KEY=
RADAR_LLM_MODEL=

# 可选：自定义上下文与消息快照文件，建议使用绝对路径。
# RADAR_CONTEXT=/absolute/path/to/context.json
# RADAR_INBOX=/absolute/path/to/inbox.json

# 演示开关：强制使用模拟消息和模拟决策，但不会自动关闭上面的 LLM。
RADAR_MOCK=false

# 日志级别默认 INFO；启动前设置才生效，例如：
# RADAR_LOG_LEVEL=DEBUG python main.py
